# 依赖
node_modules/

# 前端构建产物（由 npm run build 生成并打包进 Go 二进制）
server/webui/dist/*
!server/webui/dist/.gitkeep
web/.vite/
web/dist/

# 运行时数据：会话密钥、音频与封面缓存
server/data/
data/

# 本地环境配置（模板见 deploy/.env.example）
.env
.env.*
!.env.example

# Go 构建产物
*.exe
*.exe~
*.test
*.out
/simplemusic
/server/simplemusic
/server/simplemusic-*

# 日志
*.log
npm-debug.log*

# 编辑器与系统文件
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
