# 复制为 deploy/.env 后使用：cp .env.example .env
# 这里的变量由 docker compose 读取并传给容器，留空即使用默认值。

# 构建时拉取基础镜像（node / golang / alpine）的仓库前缀，加速站 502 或超时就换一个。
# 已在 Docker 配置 registry-mirrors 时可填 library（即官方镜像名）。
SM_REGISTRY=docker.m.daocloud.io/library

# 宿主机对外端口
SM_PORT=9003

# Navidrome 地址。留空则每个浏览器首次打开页面时自行填写（只保存在该浏览器）；
# 填写后以此为准，页面中不可修改。
# 同机部署示例：http://host.docker.internal:4533 或 http://192.168.1.10:4533
SM_NAVIDROME_URL=

# 转码码率上限（kbps）
SM_MAX_BITRATE=192

# 音频缓存上限（MB），超出后按最久未播放清理
SM_CACHE_MB=2048

# 会话加密密钥（openssl rand -hex 32）；留空则自动生成并保存到 data/secret.key
SM_SECRET=
